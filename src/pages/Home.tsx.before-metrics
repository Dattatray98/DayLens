import { useEffect, useState } from "react";
import Bottombar from "../Components/Ui/botombar";
import Navbar from "../Components/Ui/Navbar";

import { SiGoogleassistant } from "react-icons/si";
import { FaBowlFood } from "react-icons/fa6";
import { FaWalking } from "react-icons/fa";
import { FaFire } from "react-icons/fa";
import { MdKeyboardVoice } from "react-icons/md";

interface FoodLog {
    id: number;
    food: string;
    quantity: number;
    unit: string;
    calories: number;
    protein: number;
    timestamp: string;
}

interface TodaySummary {
    foodCount: number;
    calories: number;
    protein: number;
}

const DAILY_CALORIE_GOAL = 2500;
const DAILY_PROTEIN_GOAL = 140;

const Home = () => {
    const [summary, setSummary] = useState<TodaySummary>({
        foodCount: 0,
        calories: 0,
        protein: 0,
    });

    const [recentLogs, setRecentLogs] = useState<FoodLog[]>([]);
    const [loading, setLoading] = useState(true);

    useEffect(() => {
        const loadHomeData = async () => {
            try {
                const { getTodaySummary, getFoodLogs } = await import(
                    "../database/foodRepository"
                );

                const [todaySummary, foodLogs] = await Promise.all([
                    getTodaySummary(),
                    getFoodLogs(),
                ]);

                setSummary(todaySummary);
                setRecentLogs((foodLogs as FoodLog[]).slice(0, 3));
            } catch (error) {
                console.error("Failed to load home data:", error);
            } finally {
                setLoading(false);
            }
        };

        loadHomeData();
    }, []);

    const caloriePercentage = Math.min(
        100,
        (summary.calories / DAILY_CALORIE_GOAL) * 100
    );

    const proteinPercentage = Math.min(
        100,
        (summary.protein / DAILY_PROTEIN_GOAL) * 100
    );

    return (
        <div className="relative bg-black">
            <Navbar />

            <main className="flex-1 overflow-y-auto pb-22">
                {/* Overview Tab */}
                <div className="p-4 flex flex-col gap-4">
                    <h1 className="text-2xl text-white font-medium">
                        How are you feeling Today?
                    </h1>

                    <div className="bg-[#1b1d1f] overflow-hidden relative flex flex-col gap-6 justify-between rounded-2xl p-4">
                        <div className="bg-[#009ADA] blur-[140px] absolute -top-10 -right-10 h-40 w-40 opacity-60 pointer-events-none"></div>

                        <div className="flex justify-between items-center text-white">
                            <h2>Today's Overview</h2>
                            <p className="text-sm text-[#909193]">
                                {loading ? "Loading..." : "From local history"}
                            </p>
                        </div>

                        <div className="space-y-3">
                            {/* Calories */}
                            <div className="flex flex-col gap-2">
                                <div className="flex justify-between items-center">
                                    <div className="flex gap-2 items-center">
                                        <FaFire className="h-5 w-5 text-[#909193]" />
                                        <h1 className="text-[#909193] text-lg">
                                            Calories
                                        </h1>
                                    </div>

                                    <p className="text-[#909193] text-sm">
                                        {summary.calories.toFixed(0)}/
                                        {DAILY_CALORIE_GOAL} Cal
                                    </p>
                                </div>

                                <div className="w-full bg-slate-100 rounded-full h-3 overflow-hidden">
                                    <div
                                        className="bg-[#0EA5E9] h-full transition-all duration-300 ease-out rounded-full"
                                        style={{
                                            width: `${caloriePercentage}%`,
                                        }}
                                    />
                                </div>
                            </div>

                            {/* Protein */}
                            <div className="flex flex-col gap-2">
                                <div className="flex justify-between items-center">
                                    <div className="flex gap-2 items-center">
                                        <FaFire className="h-5 w-5 text-[#909193]" />
                                        <h1 className="text-[#909193] text-lg">
                                            Protein
                                        </h1>
                                    </div>

                                    <p className="text-[#909193] text-sm">
                                        {summary.protein.toFixed(1)}/
                                        {DAILY_PROTEIN_GOAL}g
                                    </p>
                                </div>

                                <div className="w-full bg-slate-100 rounded-full h-3 overflow-hidden">
                                    <div
                                        className="bg-[#0EA5E9] h-full transition-all duration-300 ease-out rounded-full"
                                        style={{
                                            width: `${proteinPercentage}%`,
                                        }}
                                    />
                                </div>
                            </div>
                        </div>

                        {/* Steps */}
                        <div>
                            <div className="flex items-center justify-between">
                                <div className="flex gap-3 items-center">
                                    <FaWalking className="bg-[#3B82F6] rounded-full h-9 w-9 p-2" />

                                    <div>
                                        <h1 className="text-[#C6C6C9] font-bold">
                                            Steps
                                        </h1>
                                        <p className="text-[#909193] text-[12px]">
                                            See Activity for live count
                                        </p>
                                    </div>
                                </div>

                                <div>
                                    <p className="text-2xl text-[#C6C6C9] text-right font-bold">
                                        --
                                    </p>
                                    <p className="text-[#3B82F6] font-medium">
                                        Activity
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {/* Wake the assistant */}
                <div className="p-5 border-y border-white/12 my-4">
                    <div className="flex items-center gap-3">
                        <SiGoogleassistant className="text-white h-7 w-7 z-50 animate-pulse" />
                        <h1 className="text-lg text-[#DFE2ED] font-medium">
                            AI Assistant tab
                        </h1>
                    </div>

                    <div className="h-80 flex flex-col justify-center items-center gap-3">
                        <div className="h-30 w-30 rounded-full bg-[#3B82F6] blur-3xl absolute animate-pulse"></div>
                        <MdKeyboardVoice className="text-white h-10 w-10 z-50 animate-pulse" />
                        <h1 className="text-white animate-pulse">
                            Start Conversation
                        </h1>
                    </div>
                </div>

                {/* Recent activities */}
                <div className="py-2">
                    <div className="flex justify-between h-10 items-center px-3">
                        <h2 className="text-2xl text-white">Recent</h2>
                        <p className="text-white text-sm">
                            {summary.foodCount} food item
                            {summary.foodCount === 1 ? "" : "s"} today
                        </p>
                    </div>

                    <div className="px-3">
                        {recentLogs.length === 0 ? (
                            <div className="border border-white/8 bg-[#1A1C1E] py-4 px-3 rounded-2xl mt-4">
                                <p className="text-gray-400 text-sm">
                                    No food logged today.
                                </p>
                            </div>
                        ) : (
                            recentLogs.map((item) => (
                                <div
                                    key={item.id}
                                    className="border border-white/8 bg-[#1A1C1E] py-2 px-3 flex items-center gap-4 rounded-2xl mt-4"
                                >
                                    <FaBowlFood className="text-[#0EA5E9] h-6 w-6" />

                                    <div className="flex flex-col justify-center">
                                        <h1 className="text-white text-lg capitalize">
                                            {item.food}
                                        </h1>

                                        <p className="text-gray-400 text-sm">
                                            {item.quantity} {item.unit} ·{" "}
                                            {item.calories.toFixed(0)} kcal ·{" "}
                                            {item.protein.toFixed(1)}g protein
                                        </p>
                                    </div>
                                </div>
                            ))
                        )}
                    </div>
                </div>
            </main>

            <Bottombar />
        </div>
    );
};

export default Home;
